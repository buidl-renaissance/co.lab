# Co.Lab Environment Variables
# Copy this file to .env.local and fill in the values

# ========================================
# Application
# ========================================
NEXT_PUBLIC_APP_URL=https://co.lab.builddetroit.xyz

# ========================================
# Database (Turso/LibSQL)
# ========================================
TURSO_DATABASE_URL=file:./dev.sqlite3
TURSO_AUTH_TOKEN=

# ========================================
# MCP API (Model Context Protocol)
# ========================================
# API key for authenticating MCP tool calls via POST /api/mcp
# Generate a secure random string for production use
MCP_API_KEY=your-secret-key

# ========================================
# OpenAI
# ========================================
OPENAI_API_KEY=

# ========================================
# Farcaster / Neynar
# ========================================
FARCASTER_SIGNER_UUID=
NEYNAR_API_KEY=
FARCASTER_ACCOUNT_ASSOCIATION_HEADER=
FARCASTER_ACCOUNT_ASSOCIATION_PAYLOAD=
FARCASTER_ACCOUNT_ASSOCIATION_SIGNATURE=

# ========================================
# GitHub OAuth
# ========================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ========================================
# DigitalOcean Spaces (File Storage)
# ========================================
DO_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# ========================================
# Events API
# ========================================
EVENTS_API_URL=
EVENTS_API_KEY=
